# Configuración de Portfolio Manager
ENVIRONMENT=development
PORT=8000

# Supabase: clave publicable (o anon heredada), nunca service_role.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
CORS_ORIGINS=http://localhost:5173

# Solo backend. Crear la clave en https://aistudio.google.com/api-keys
GEMINI_API_KEY=
# Modelo con visión y salida estructurada disponible en tu proyecto de AI Studio.
GEMINI_MODEL=gemini-3.5-flash-lite

